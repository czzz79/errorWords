{
  "description": "GT3 英文单词/缩写：结构化 CMU 音素扰动，经 CosyVoice3 clean 音频与 WSL Qwen3-ASR 挖掘 GT 混淆词。",
  "input_txt": "resources/gt3-by-type/english-word-acronym.txt",
  "output_dir": "outputs/experiments/gt3-english-cmu-cosy-clean",
  "output_readme": "# GT3 English CMU clean experiment\n\nInput: `resources/gt3-by-type/english-word-acronym.txt` (all English/acronym GT terms).\n\nTest: canonical CMU baseline plus target-blind single-rule English CMU variants. CosyVoice3 receives `phoneme_text`; no audio augmentation is applied.\n\nOutputs: `samples.json`, `pronunciation/`, `tts/`, `asr-input-manifest.jsonl`, `results/`, and `report/`.\n\nASR: managed WSL Qwen3-ASR, temperature 0.65, top_p 1.0, top_k 50, min_p 0.0, seed null.",
  "sample_language": "English",
  "include_known_confusions": false,
  "stages": {
    "pronunciation": true,
    "tts": true,
    "augmentation": true,
    "asr": true,
    "report": true,
    "dictionary_postprocess": false
  },
  "pronunciation": {
    "mode": "english_cmu",
    "rules_path": "src/error_words_tts/pronunciation/rules/english-cmu.json",
    "overrides_path": "resources/pronunciation/english-pronunciation-overrides.json",
    "include_boundary_variants": false,
    "max_variants_per_term": 40
  },
  "tts": {
    "runs": [
      {
        "name": "cosyvoice-cmu",
        "python": "D:\\anaconda\\envs\\cosyvoice\\python.exe",
        "engine_config": "src/error_words_tts/tts/configs/cosyvoice3-cmu-neutral-clear.json"
      }
    ]
  },
  "augmentation": {
    "include_original_audio": true,
    "seed": 20260804,
    "continue_on_error": true,
    "perturbations": []
  },
  "asr": {
    "workers": 1,
    "language": null,
    "prompt": null,
    "timeout_seconds": 180,
    "wait_seconds": 300,
    "continue_on_error": true,
    "repeats": 1,
    "service": {
      "mode": "managed",
      "distribution": "Ubuntu-24.04",
      "working_directory": "/home/jsqdc/qwen3-asr",
      "python": "/home/jsqdc/miniconda3/envs/qwenasr/bin/python",
      "base_config": "config/service-ideahub-random.yaml",
      "host": "127.0.0.1",
      "port": 8756
    },
    "conditions": [
      {
        "name": "english-cmu-t065-p100-k050-mp000",
        "temperature": 0.65,
        "top_p": 1.0,
        "top_k": 50,
        "min_p": 0.0,
        "seed": null
      }
    ]
  }
}
