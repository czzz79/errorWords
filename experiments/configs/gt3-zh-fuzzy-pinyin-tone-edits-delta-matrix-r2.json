{
  "description": "GT3 中文单音节增量矩阵：只测试目标声调载体与单个音节插入/删除载体；不重跑 canonical、静态规则或已完成的组件补全实验。CosyVoice 六种指令，每条音频加原音和五种后处理，使用既定随机 ASR 解码。",
  "input_txt": "resources/gt3-by-type/zh-single-syllable.txt",
  "output_dir": "outputs/experiments/gt3-zh-fuzzy-pinyin-tone-edits-delta-matrix-r2",
  "sample_language": "Chinese",
  "include_known_confusions": false,
  "stages": {
    "pronunciation": true,
    "tts": true,
    "augmentation": true,
    "asr": true,
    "report": true,
    "dictionary_postprocess": false
  },
  "pronunciation": {
    "mode": "fuzzy_pinyin",
    "rules_path": "resources/chinese-fuzzy-pinyin-rules.csv",
    "derive_gt_component_rules": true,
    "use_gt_target_tones": true,
    "derive_gt_syllable_edits": true,
    "include_canonical": false,
    "include_variant_origins": [
      "gt_target_component_tone",
      "gt_target_syllable_edit"
    ],
    "exclude_known_confusion_texts": true,
    "max_rule_level": 3,
    "max_carriers_per_pinyin": 3,
    "max_variants_per_term": 60,
    "carrier_rime_dictionary": "resources/wusong-base.dict.yaml",
    "carrier_high_frequency_words": "resources/high_frequency_words.txt",
    "carrier_jieba_dictionary": "resources/jieba-dict.txt"
  },
  "tts": {
    "runs": [
      {
        "name": "cosyvoice",
        "python": "D:\\anaconda\\envs\\cosyvoice\\python.exe",
        "engine_config": "src/error_words_tts/tts/configs/cosyvoice3-pronunciation.json"
      }
    ]
  },
  "augmentation": {
    "include_original_audio": true,
    "seed": 20260804,
    "continue_on_error": true,
    "perturbations": [
      {"name": "speed-090", "type": "speed", "factor": 0.9},
      {"name": "speed-110", "type": "speed", "factor": 1.1},
      {"name": "noise-18db", "type": "white_noise", "snr_db": 18},
      {"name": "lowpass-3200hz", "type": "lowpass", "cutoff_hz": 3200},
      {"name": "hard-clip-035", "type": "hard_clip", "threshold": 0.35}
    ]
  },
  "asr": {
    "workers": 1,
    "language": null,
    "prompt": null,
    "timeout_seconds": 180,
    "wait_seconds": 300,
    "continue_on_error": true,
    "repeats": 1,
    "service": {
      "mode": "managed",
      "distribution": "Ubuntu-24.04",
      "working_directory": "/home/jsqdc/qwen3-asr",
      "python": "/home/jsqdc/miniconda3/envs/qwenasr/bin/python",
      "base_config": "config/service-ideahub-random.yaml",
      "host": "127.0.0.1",
      "port": 8756
    },
    "conditions": [
      {
        "name": "fuzzy-pinyin-tone-edits-t065-p100-k050-mp000",
        "temperature": 0.65,
        "top_p": 1.0,
        "top_k": 50,
        "min_p": 0.0,
        "seed": null
      }
    ]
  }
}
